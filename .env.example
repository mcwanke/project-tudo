# Tududi
# TUDUDI_URL is the public-facing address -- it gets baked directly into
# habit action buttons, which your PHONE calls directly (habits bypass the
# relay; their endpoints are POST, which works fine from ntfy's app). Keep
# it phone-reachable.
TUDUDI_URL=https://your-tududi-host
# Optional: this service's OWN calls (polling + the relay's complete/cancel)
# can instead go straight over your Docker network, skipping any reverse
# proxy/auth middleware in front of TUDUDI_URL entirely -- useful since this
# container and Tududi often run on the same host. Defaults to TUDUDI_URL
# when unset.
TUDUDI_INTERNAL_URL=http://tududi:3002
TUDUDI_TOKEN=tt_xxxxxxxxxxxxxxxx

# ntfy
NTFY_URL=http://192.168.1.1:8081
NTFY_TOPIC=tududi
# Empty = no auth. "token:<value>" for a bearer token, or "user:pass" for basic auth.
NTFY_AUTH=

# Relay: ntfy's Android app cannot fire PATCH action buttons (confirmed --
# the request never reaches the server), but Tududi only exposes task
# completion/cancellation via PATCH. So task Complete/Cancel buttons POST to
# this service's own built-in relay (see src/tudo_ntfy/relay.py), which
# re-issues the request as a server-to-server PATCH to Tududi. Habits don't
# need this -- their POST endpoints work directly from the phone.
#
# RELAY_URL must be reachable by your PHONE (same requirement as TUDUDI_URL):
# the LAN/public address of wherever this container runs, port 8787 unless
# changed below. RELAY_SECRET protects the relay endpoint -- generate one
# with: openssl rand -hex 24
RELAY_URL=http://192.168.1.1:8787
RELAY_SECRET=change-me-generate-a-real-secret
RELAY_PORT=8787

# Required: IANA timezone name, used for all date-only due-date/habit math.
TIMEZONE=America/New_York

# Polling
POLL_INTERVAL=60
NOTIFY_LEAD_MINUTES=0
NOTIFY_TIME=07:00

# Priority-based cadence (see docs/tududi-api-notes.md and the plan for the
# full policy table)
MEDIUM_PRIORITY_TIMES=07:00,19:00
HIGH_PRIORITY_INTERVAL_MINUTES=60
HABIT_UNIT_REMIND_INTERVAL_MINUTES=120

# Comma-separated tag names (case-insensitive). Tag a task OR its project
# with any of these to silence notifications for it entirely.
SKIP_TAGS=

# Where the dedup/rate-limit SQLite file lives (mount a volume over its
# parent directory so state survives container restarts).
STATE_PATH=/data/state.db
